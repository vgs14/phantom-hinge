# Build settings for the kiosk image. Read by scripts/build.sh and the
# numbered scripts - this is the only place the Alpine version lives.
#
# Network settings (IPs, subnet, interface) are the boot server's
# business, not the image's - see srv/.env.

# Alpine release and architecture the kiosk runs. Changing ALPINE_VER and
# rebuilding is a complete version bump - nothing else needs editing.
ALPINE_VER=3.21
ARCH=x86_64

# 1 = repeatable builds: reuse the cached APKINDEX (builder/apkindex_cache/)
# instead of checking dl-cdn for an updated one, and never re-check
# packages already in the mirror. Rebuilds then produce the same package
# set every time. Needs at least one normal (0) build first to populate the
# cache. Set back to 0 to pick up Alpine's security updates.
APK_FREEZE=0
