# Build-time settings for the lobby-board front end.
#
# Vite reads this file during "npm run build" (build.sh) and bakes every
# VITE_* value into the JavaScript bundle - see src/config.js for how
# they're used. Changing one means rebuilding the SquashFS; nothing reads
# this file on the kiosk.
#
# Everything here ends up in a file nginx serves to anyone on the boot
# network, so never put secrets in it.
#
# Per-site overrides: put them in .env.<mode> (e.g. .env.york) and build
# with "MODE=york ./build.sh". Vite loads .env first, then .env.<mode> on
# top. .env.local / .env.<mode>.local are for your own machine and are
# gitignored.

# Shown in the header and on the welcome page.
VITE_SITE_NAME="Hinge & Co. Head Office"
VITE_WELCOME_MESSAGE="Welcome. Please sign in at reception and we'll let your host know you're here."

# Accent colour used for highlights and the active page.
VITE_ACCENT_COLOR="#4f8cff"

# IANA time zone for every time shown. Chromium has its own time zone data,
# so this works even though the kiosk itself runs in UTC.
VITE_TIME_ZONE="Europe/London"
VITE_LOCALE="en-GB"

# Seconds of no touch/mouse input before the board moves to the next page.
# 0 turns the rotation off.
VITE_ROTATE_SECONDS=20

# How often each page re-fetches its data from the backend, in seconds.
VITE_REFRESH_SECONDS=30
