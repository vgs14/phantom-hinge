# Boot server network settings - the only place these live. Docker Compose
# reads this file automatically; docker-compose.yml uses them for the
# container IPs and passes the IP-dependent options to dnsmasq.
#
# The kiosks find the HTTP server by name (boot.lan, answered by dnsmasq
# with HTTP_IP), so nothing under builder/ or in autoexec.ipxe needs
# changing when these do.

# Host network interface the boot network is on (see the ipvlan note in
# the README). This MUST be the dedicated boot network, never your main
# LAN: dnsmasq is an authoritative DHCP server that PXE-boots everything
# it sees, so on the wrong interface it takes over that whole network.
PARENT_IF=ens37

# Boot network.
SUBNET=10.1.1.0/24
DHCP_RANGE_START=10.1.1.1
DHCP_RANGE_END=10.1.1.99
DHCP_NETMASK=255.255.255.0

# Container IPs - must be inside SUBNET and outside the DHCP range.
DNSMASQ_IP=10.1.1.100
HTTP_IP=10.1.1.110

# Alpine release the two server containers are built from. This is just
# their base image - it doesn't have to match the kiosk's ALPINE_VER in
# builder/config.env. Rebuild with `docker compose up -d --build`.
SERVER_ALPINE_RELEASE=3.21
